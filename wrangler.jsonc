// Cloudflare Workers config. The site is a static export (`next build` writes
// `out/`), so the Worker has no script: every request is served from static
// assets, which the Workers Free plan serves without request or CPU limits.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calvada-research",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    // Matches `trailingSlash: true` in next.config.mjs: /alameda -> /alameda/
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "research.calvada-webhooks.com", "custom_domain": true }
  ],
  // Only the custom domain serves the site; no *.workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false
}
